<?xml version="1.0" encoding="UTF-8"?>
<!-- Put this folder on HOUDINI_PATH (…/houdini) and ilp_gallery on PYTHONPATH.
     Then: New Pane Tab Type > Misc > ILP Gallery. -->
<pythonPanelDocument>
  <interface name="ilp_gallery" label="ILP Gallery" icon="MISC_python" showNetworkNavigationBar="false" help_url="">
    <script><![CDATA[
from ilp_gallery import dcc


def onCreateInterface():
    return dcc.houdini_panel_widget()
]]></script>
    <includeInPaneTabMenu menu_position="0" create_separator="false"/>
    <includeInToolbarMenu menu_position="200" create_separator="false"/>
    <help><![CDATA[]]></help>
  </interface>
</pythonPanelDocument>
